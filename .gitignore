# ==========================================
# Root .gitignore for AppointmentBookingSystem (.NET + Angular)
# ==========================================

# Node & Frontend Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Angular Build & Cache
dist/
*/dist/
.angular/
*/.angular/
tmp/
out-tsc/
bazel-out/

# .NET Build Outputs
[Bb]in/
[Oo]bj/
*/[Bb]in/
*/[Oo]bj/
*/AppointmentBooking.*/bin/
*/AppointmentBooking.*/obj/

# Visual Studio / Rider / IDE Cache
.vs/
*/.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.ide
.idea/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS & Logs
*.log
.DS_Store
Thumbs.db
